# Core configuration
EASY_AGENT_CONFIG_PATH=config/easy_agent.yaml
EASY_AGENT_DB_PATH=data/easy_agent.duckdb
EASY_AGENT_LOG_PATH=data/logs/audit.jsonl
EASY_AGENT_POLICY_PATH=policies/default_policy.yaml
EASY_AGENT_GMAIL_SEED_PATH=data/seed/demo_messages.json
EASY_AGENT_TOOL_CATALOG_PATH=data/tool_catalog.json
EASY_AGENT_MEMORY_COLD_PATH=data/memory/cold_memories.jsonl
EASY_AGENT_SLEEPING_TASKS_PATH=data/memory/sleeping_tasks.jsonl
EASY_AGENT_MEMORY_TABLES_PATH=config/memory_tables.yaml
EASY_AGENT_MEMORY_POLICIES_PATH=config/memory_policies.yaml

# Runtime behavior
EASY_AGENT_SOURCE=fake
EASY_AGENT_CLASSIFIER_MODE=rules
EASY_AGENT_LLM_ENABLED=false
EASY_AGENT_POLL_SECONDS=300

# Default model adapter
EASY_AGENT_LLM_PROVIDER=huggingface
EASY_AGENT_LLM_MODEL_NAME=Qwen/Qwen3-1.7B
EASY_AGENT_LLM_DEVICE_MAP=auto
EASY_AGENT_LLM_TORCH_DTYPE=auto
# EASY_AGENT_LLM_MAX_NEW_TOKENS=512
EASY_AGENT_LLM_THINKING=true

# Optional planner model
EASY_AGENT_PLANNER_ENABLED=false
EASY_AGENT_PLANNER_PROVIDER=function_gemma
EASY_AGENT_PLANNER_MODEL_NAME=google/functiongemma-270m-it
EASY_AGENT_PLANNER_DEVICE_MAP=auto
EASY_AGENT_PLANNER_TORCH_DTYPE=auto
# EASY_AGENT_PLANNER_MAX_NEW_TOKENS=256

# Memory
EASY_AGENT_MEMORY_HOT_CACHE_SIZE=256
EASY_AGENT_MEMORY_ARCHIVE_AFTER_DAYS=30
EASY_AGENT_MEMORY_ESCALATION_STEP_COUNT=3
EASY_AGENT_MEMORY_CONFIDENCE_THRESHOLD=0.5
EASY_AGENT_MEMORY_SIMILARITY_ENABLED=false
EASY_AGENT_MEMORY_SIMILARITY_BACKEND=none
EASY_AGENT_MEMORY_EMBEDDING_PROVIDER=sentence_transformer
EASY_AGENT_MEMORY_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EASY_AGENT_MEMORY_HYBRID_SEARCH_ENABLED=false
EASY_AGENT_MEMORY_VECTOR_TOP_K=20

# Local/mock notification defaults
EASY_AGENT_WHATSAPP_MODE=fake
EASY_AGENT_WHATSAPP_ALLOWLIST=
EASY_AGENT_NOTIFICATION_DESTINATION=
EASY_AGENT_VIEWER_HOST=127.0.0.1
EASY_AGENT_VIEWER_PORT=8000

# Gmail OAuth. Leave blank unless Gmail is enabled.
EASY_AGENT_GMAIL_CLIENT_ID=
EASY_AGENT_GMAIL_CLIENT_SECRET=
EASY_AGENT_GMAIL_CREDENTIALS_PATH=data/gmail_credentials.json
EASY_AGENT_GMAIL_TOKEN_PATH=data/gmail_token.json

# Twilio WhatsApp. Leave blank while EASY_AGENT_WHATSAPP_MODE=fake.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
EASY_AGENT_TWILIO_WHATSAPP_FROM=

# Hosted or OpenAI-compatible model providers. Populate only the provider in use.
OPENAI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com
OLLAMA_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_PATH=/v1/chat/completions

# Generic endpoint/openai-compatible adapters used by MailMind.
EASY_AGENT_LLM_ENDPOINT_URL=
EASY_AGENT_LLM_BASE_URL=
EASY_AGENT_LLM_API_KEY=
